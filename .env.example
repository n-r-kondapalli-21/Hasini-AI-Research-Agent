# ============================================================
# API Keys
# ============================================================

OPENROUTER_API_KEY=your_openrouter_api_key_here
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here
ZAI_API_KEY=your_zai_api_key_here

# ============================================================
# LLM Configuration
# ============================================================

# Select LLM provider: openrouter, google, or zai
LLM_PROVIDER=openrouter

# Model name (optional, depends on provider)
MODEL_NAME=


# Enable/disable individual built-in tools
ENABLE_WEB_TOOL=true
ENABLE_WEATHER_TOOL=true
ENABLE_CALCULATOR_TOOL=true

# ============================================================
# MCP Server Enable/Disable Flags
# ============================================================

# Enable/disable individual MCP servers
ENABLE_MCP_FILESYSTEM=true
ENABLE_MCP_GITHUB=true
ENABLE_MCP_OPENALGO=true


# ============================================================
# Tool API Keys
# ============================================================

TAVILY_API_KEY=your_tavily_api_key_here

# ============================================================
# MCP Server Configuration
# ============================================================

GITHUB_TOKEN=your_github_token_here
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
OPENALGO_API_KEY=your_openalgo_api_key_here
OPENALGO_URL=http://127.0.0.1:5000


# MCP Server Paths (optional - defaults are used if not set)
# Defaults: AI_RESEARCH_DIR=./AI_Research, OPENALGO_PYTHON_PATH=python, OPENALGO_MCP_SERVER=./mcp/mcpserver.py
# Uncomment and modify these if you need custom paths:
# AI_RESEARCH_DIR=D:\Hasini_Ai_Research_Agent\AI_Research
# OPENALGO_PYTHON_PATH=D:\Algo_Trading_OpenAlgo\openalgo\.venv\Scripts\python.exe
# OPENALGO_MCP_SERVER=D:\Algo_Trading_OpenAlgo\openalgo\mcp\mcpserver.py

# ============================================================
# Telegram Bot Configuration
# ============================================================

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================================
# Conversation Memory
# ============================================================

# Set to false to disable conversation history entirely
MEMORY_ENABLED=true

# Maximum number of messages (user + assistant) to keep in memory
MEMORY_HISTORY_LIMIT=10

# ============================================================
# RAG Knowledge System Configuration
# ============================================================

# Enable or disable RAG knowledge retrieval (true/false)
RAG_ENABLED=true

# Path to ChromaDB persistent storage directory
CHROMADB_PATH=./data/chroma_db

# Local embedding model storage path (relative to project root)
RAG_EMBEDDING_MODEL_PATH=models/embeddings/all-MiniLM-L6-v2

# HuggingFace model identifier for first-time download
RAG_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Maximum number of top relevant chunks to retrieve
RAG_TOP_K=5

# Relevance / similarity score threshold (0.0 to 1.0)
# Chunks with similarity score below this value will be ignored
RAG_SIMILARITY_THRESHOLD=0.3

# ============================================================
# Hybrid Search Configuration
# ============================================================

# Enable/disable BM25 keyword search (true/false)
RAG_BM25_ENABLED=true

# Number of top results from vector search before fusion
RAG_VECTOR_TOP_K=10

# Number of top results from BM25 search before fusion
RAG_BM25_TOP_K=10

# RRF constant k (default 60 as per original paper)
RAG_RRF_K=60

# Enable/disable cross-encoder reranking (true/false)
RAG_RERANKER_ENABLED=true

# Number of top candidates to pass to reranker
RAG_RERANKER_TOP_K=20

# Reranker relevance threshold (0.0 to disable filtering)
RAG_RERANKER_THRESHOLD=0.0

# Final number of chunks to return after all processing
RAG_FINAL_TOP_K=4


