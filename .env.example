# ============================================================
# API Keys
# ============================================================

OPENROUTER_API_KEY=your_openrouter_api_key_here
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here
ZAI_API_KEY=your_zai_api_key_here

# ============================================================
# LLM Configuration
# ============================================================

# Select LLM provider: openrouter, google, or zai
LLM_PROVIDER=openrouter

# Model name (optional, depends on provider)
MODEL_NAME=

# ============================================================
# Tool API Keys
# ============================================================

TAVILY_API_KEY=your_tavily_api_key_here

# ============================================================
# MCP Server Configuration
# ============================================================

GITHUB_TOKEN=your_github_token_here
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
OPENALGO_API_KEY=your_openalgo_api_key_here
OPENALGO_URL=http://127.0.0.1:5000

# ============================================================
# Telegram Bot Configuration
# ============================================================

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================================
# Conversation Memory
# ============================================================

# Set to false to disable conversation history entirely
MEMORY_ENABLED=true

# Maximum number of messages (user + assistant) to keep in memory
MEMORY_HISTORY_LIMIT=10

# ============================================================
# Tool Enable/Disable Flags
# ============================================================

# Enable/disable individual built-in tools
ENABLE_WEB_TOOL=true
ENABLE_WEATHER_TOOL=true
ENABLE_CALCULATOR_TOOL=true

# ============================================================
# MCP Server Enable/Disable Flags
# ============================================================

# Enable/disable individual MCP servers
ENABLE_MCP_FILESYSTEM=true
ENABLE_MCP_GITHUB=true
ENABLE_MCP_OPENALGO=true
