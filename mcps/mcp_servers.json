
{
    "filesystem": {
        "transport": "stdio",
        "command": "mcp-server-filesystem",
        "args": [
            "${AI_RESEARCH_DIR:-./AI_Research}"
        ]
    },

    "github": {
        "transport": "streamable_http",
        "url": "${GITHUB_MCP_URL}",
        "headers": {
            "Authorization": "${GITHUB_TOKEN}"
        }
    },

    "openalgo": {
        "transport": "stdio",
        "command": "${OPENALGO_PYTHON_PATH:-python}",
        "args": [
            "${OPENALGO_MCP_SERVER:-./mcp/mcpserver.py}",
            "${OPENALGO_API_KEY}",
            "${OPENALGO_URL}"
        ]
    }
}